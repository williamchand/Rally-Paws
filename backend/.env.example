# Copy to .env and fill in. Never commit .env or put these keys in the web app.
# Meta Model API (required for POST /api/chat; deterministic endpoints work without it)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3

# Server-side secret for activity-confirmation tokens (required, any long random string)
CONFIRM_SECRET=change-me-to-a-long-random-secret

# RevenueCat server-side verification (optional). Without the secret key the
# app runs its demo billing flow, clearly labelled as planned in the UI.
REVENUECAT_SECRET_KEY=
REVENUECAT_BASE_URL=https://api.revenuecat.com
REVENUECAT_ENTITLEMENT=plus

# Comma-separated extra origins allowed to call the API (Vite dev default included).
# Not needed for the single-service Blueprint deploy (same-origin).
CORS_EXTRA_ORIGINS=
